# Copy this file to .env.local and fill in both values.
# Supabase Dashboard → Project Settings → API (or "API Keys").
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the secret key (sb_secret_...) or the legacy service_role key.
# It stays on the server — never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
